# examples/echo.policy
#
# A minimal, safe policy: run `echo` with a fixed greeting, a clean
# environment, no declared network use, and a 2-second timeout.

name = echo-demo

[exec]
program = echo
timeout_ms = 2000

[args]
# Always pass this greeting; callers may additionally pass -n.
fixed = hello from palisade
allow = -n

[env]
# Start from an empty environment; only expose what is listed.
mode = clean
pass = HOME
pass += PATH
set = PALISADE_DEMO=1

[net]
