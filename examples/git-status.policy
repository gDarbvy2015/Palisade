# examples/git-status.policy
#
# Run `git status` with an inherited environment (git needs HOME, PATH, and
# often credential helpers), but drop a couple of sensitive variables. The
# arguments are locked down to the exact subcommand.

name = git-status

[exec]
program = git
timeout_ms = 10000

[args]
fixed = status
fixed += --short
# No extra caller arguments permitted.
allow_extra = false

[env]
mode = inherit
# Do not leak these into the child.
remove = AWS_SECRET_ACCESS_KEY
remove += GITHUB_TOKEN

[net]
# `git status` is local-only.
mode = none
