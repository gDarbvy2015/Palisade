# examples/network-fetch.policy
#
# A network-using command. This intentionally exercises several linter
# advisories so `palisade-lint` output is interesting:
#   - net.mode = allow  -> P200 (advisory only)
#   - env.mode = inherit -> P102 (prefer clean)
#   - args.allow_extra = true -> P103 (arbitrary args)
#
# palisade cannot actually prevent or permit network access; net.mode is a
# declaration of intent recorded in the receipt.

name = network-fetch

[exec]
program = curl
timeout_ms = 15000

[args]
fixed = --silent
